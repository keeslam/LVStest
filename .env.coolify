# Coolify Environment Variables Template
# Copy these variables to your Coolify project environment settings

# Server Configuration
NODE_ENV=production
PORT=3000

# SSL/HTTPS Configuration (for existing ZeroSSL certificates)
ENABLE_HTTPS=true
SSL_KEY_PATH=/path/to/your/private.key
SSL_CERT_PATH=/path/to/your/certificate.crt

# Database Configuration (Use your Coolify database service internal URL)
DATABASE_URL=postgresql://username:password@database:5432/car_rental
PGUSER=your_db_user
PGPASSWORD=your_db_password
PGHOST=database
PGPORT=5432
PGDATABASE=car_rental

# Session Secret (Generate a random secret for production)
SESSION_SECRET=your_secure_random_session_secret_here

# Application Settings
UPLOAD_DIR=/app/uploads

# Coolify Predefined Variables (automatically available)
# COOLIFY_URL - Your application URL
# COOLIFY_PROJECT_UUID - Project identifier

# IMPORTANT: Set up a persistent volume in Coolify
# Volume Name: uploads-storage
# Source Path: /app/uploads
# Destination Path: /app/uploads
# This ensures uploaded files persist across deployments

# IMPORTANT: backups need a persistent volume too
# Volume Name: backups-storage
# Source Path: /app/backups
# Destination Path: /app/backups
# The backup service writes to <cwd>/backups, which is inside the container.
# With no volume mounted there, every nightly backup is destroyed on the next
# redeploy. (This only applies to the default local_filesystem storage mode; if
# you configure object storage in the backup settings instead, backups go
# off-box and this volume is not needed.)

# SECURE_COOKIES
# Leave unset when the app is served over HTTPS.
# Set to false ONLY while reaching the app over plain http:// (a LAN test box,
# a VM without TLS). The browser refuses to store a Secure cookie over HTTP, so
# login appears to succeed and every request afterwards returns 401.
# SECURE_COOKIES=false